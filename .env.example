OPENAI_API_KEY="sk-1234"
ANTHROPIC_API_KEY=""
PROMPT_TOOLKIT_NO_CPR=1
CAI_STREAM=false
CAI_MODEL="alias1"

# --- Local model support (Ollama) ---
# Set OLLAMA=true and point OLLAMA_API_BASE at your Ollama server.
# Ollama's default OpenAI-compatible endpoint is http://localhost:11434/v1
# Example:
#   OLLAMA=true
#   OLLAMA_API_BASE=http://localhost:11434/v1
#   CAI_MODEL=llama3.2:3b
OLLAMA=
OLLAMA_API_BASE=

# --- LiteLLM proxy server support ---
# If you run a LiteLLM proxy (e.g. `litellm --config config.yaml`),
# set LITELLM_BASE_URL to route all non-provider-specific calls through it.
# Example:
#   LITELLM_BASE_URL=http://localhost:4000
#   LITELLM_API_KEY=key
#   CAI_MODEL=gpt-4o   # or whatever the proxy exposes
LITELLM_BASE_URL=
LITELLM_API_KEY=